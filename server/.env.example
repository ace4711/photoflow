# Kopiera till .env (0600). Inga hemligheter i repot: fyll i värdena själv eller rendera från sops.

# Krävs i produktion (minst 32 tecken). Skapa med: openssl rand -base64 48
OBJEKTFILM_SIGNING_KEY=

# Publik bas-URL som länkar byggs av (utan avslutande snedstreck)
OBJEKTFILM_PUBLIC_URL=https://film.eriksvik.site

# production (standard) kräver signeringsnyckel. dev tillåter tillfällig nyckel.
OBJEKTFILM_ENV=production

# Portbindning på värden (compose.yaml). 10.0.0.37 på server3, 127.0.0.1 i dev.
OBJEKTFILM_BIND=10.0.0.37
OBJEKTFILM_HTTP_PORT=8470
OBJEKTFILM_METRICS_HOST_PORT=9471

# Resurser
OBJEKTFILM_MEM_LIMIT=512m

# Valfritt (standardvärden i parentes)
# OBJEKTFILM_PURGE_DAYS=90
# OBJEKTFILM_MIN_FREE_BYTES=5368709120
# OBJEKTFILM_EXTRA_ORIGINS=
# OBJEKTFILM_LOKI_URL=http://10.0.0.5:3100/loki/api/v1/push
